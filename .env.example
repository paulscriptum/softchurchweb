# admin: /admin
ADMIN_PASSWORD=
# optional, signs the admin session; defaults to ADMIN_PASSWORD
ADMIN_SECRET=

# vercel blob: a private store connected with prefix DATA, a public store with prefix MEDIA.
# vercel adds these automatically when the stores are connected to the project.
DATA_READ_WRITE_TOKEN=
MEDIA_READ_WRITE_TOKEN=

# optional: pass witnesses on to an email provider
BUTTONDOWN_API_KEY=
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
